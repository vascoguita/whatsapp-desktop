{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Desktop",
  "version": "0.1.0",
  "identifier": "org.guita.whatsapp-desktop",
  "app": {
    "windows": [
      {
        "title": "WhatsApp Desktop",
        "url": "https://web.whatsapp.com",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "publisher": "Vasco Guita",
    "shortDescription": "WhatsApp Desktop",
    "longDescription": "A desktop application for Linux that wraps WhatsApp Web",
    "icon": [
      "icons/icon.png"
    ]
  }
}